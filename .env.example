# --- Google OAuth (from Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- NextAuth ---
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Your live URL in production, e.g. https://onekyc-zeta.vercel.app
NEXTAUTH_URL=

# --- Didit (KYC + liveness provider) ---
# TODO: fill in once you're ready to wire in real verification.
# Until then, lib/didit.js runs in MOCK mode automatically.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=

# --- Database (Supabase or Neon) ---
# TODO: fill in once you've created an account.
# Until then, lib/db.js runs on an in-memory mock store automatically.
DATABASE_URL=
